# Server
PORT=3000
NODE_ENV=development

# Security
API_KEY=your-secret-api-key-here

# Paths
AUDIO_LIBRARY_PATH=./data/audio-library.json
AUDIO_FILES_ROOT=/media/audio

# Session
SESSION_IDLE_TIMEOUT_MS=300000
SESSION_CLEANUP_INTERVAL_MS=60000

# Streaming
HLS_SEGMENT_DURATION=10
HLS_BITRATES=64,128,256

# Logging
LOG_LEVEL=info
